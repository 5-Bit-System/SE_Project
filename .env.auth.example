# See docs/LOCAL_SETUP.md. Create ignored .env.auth only if missing.
# Never commit the generated secret or SMTP password; keep existing valid settings.
APP_ENV=local
PUBLIC_BASE_URL=http://127.0.0.1:8000
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_PEPPER=replace-with-a-generated-secret
EMAIL_BACKEND=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=So hoc tap <noreply@sohoctap.test>
# Production: APP_ENV=production, HTTPS origins, real SMTP + starttls/tls,
# no active seeded_for_dev accounts; no fake transport or .test registration.
