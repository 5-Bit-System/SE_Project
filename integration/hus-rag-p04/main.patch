+                    pending_scrolls: p.viewport_?.scrollContent_?.unackedScrollsToRemote_,
+                    viewport: p.viewport_?.position};
+            }""")
+            inner = next((f for f in popup.frames if f != popup.main_frame and f.url == expected_url), None)
