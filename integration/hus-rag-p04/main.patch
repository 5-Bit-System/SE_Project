+test('unbound or blocked contexts never send requests; session expiration clears pending chat', async () => {
+  const {chat, state, emit, pending} = setup();
+  state.binding = false; await chat.refresh();
+  assert.equal(chat.state.context, null);
+  assert.equal(chat.elements.send.disabled, true);
+  state.binding = true; state.status = 'needs_policy_review'; await chat.refresh();
