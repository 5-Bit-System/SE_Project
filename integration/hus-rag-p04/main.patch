+def _sha(path, normalized=False):
+    raw = path.read_bytes()
+    return hashlib.sha256(raw.replace(b"\r\n", b"\n") if normalized else raw).hexdigest()
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--with-browser", action="store_true")
+    args = parser.parse_args(argv)
+    out = args.out.resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    report = {"schema_version": "1.0", "status": "running", "started_at": datetime.now(timezone.utc).isoformat(),
+              "acceptance_level": "http_and_browser" if args.with_browser else "http_only",
+              "scope": "main live auth/context/UI with synthetic repository/policy/catalog fixtures and real HUS v3",
+              "product_database_modified": False, "vnu_contacted": False, "llm_used": False,
+              "auth_repository": "synthetic_in_memory_double_not_database_transaction_acceptance",
+              "catalog_policy_review": "synthetic_test_only_no_product_signoff_added",
+              "browser": "not_run", "artifact_directory": str(out)}
+    try:
+        report["integration_base_commit"] = subprocess.check_output(
+            ["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
+        report["integration_branch"] = subprocess.check_output(
+            ["git", "branch", "--show-current"], cwd=ROOT, text=True).strip()
+        report["pinned_main_base"] = "5239b7333a8f8cdf0f919e6b0505af0def99fe23"
+        oracle = EvidenceOracle()
+        report["selected_release"] = oracle.current
+        manifest = json.loads((oracle.root / "manifest.json").read_bytes())
+        inputs = [oracle.package / "CURRENT.json", oracle.root / "manifest.json",
+                  oracle.asset_root / "registry.json"]
+        inputs += [oracle.root / name for name in manifest["files"]]
+        inputs += [oracle.asset_root / e["path"] for e in oracle.asset_registry["assets"].values()]
+        report["input_sha256"] = {p.relative_to(ROOT).as_posix(): _sha(p) for p in sorted(inputs)}
+        code = [p for p in (ROOT / "app").rglob("*") if p.is_file() and p.suffix in {".py", ".js", ".css", ".html"}]
+        code += [Path(__file__), ROOT / "tools/hus_evidence_oracle.py"]
+        report["implementation_sha256"] = {p.relative_to(ROOT).as_posix(): _sha(p, True) for p in sorted(code)}
+        verification = [ROOT / name for name in ["tests/support/system_auth.py", "tests/support/catalog_fixtures.py",
+                       "tests/integrations/test_academic_api.py", "tests/integrations/test_hus_academic_api.py",
+                       "tests/frontend/hus-chat.test.cjs", "tests/conftest.py"]]
+        report["verification_sha256"] = {p.relative_to(ROOT).as_posix(): _sha(p, True) for p in verification}
+        with isolated_server(out) as state:
+            report["api"] = api_acceptance(state, oracle)
+            if args.with_browser:
+                report["browser"] = browser_acceptance(state, out, oracle)
+        for category, normalized in [("input_sha256", False), ("implementation_sha256", True), ("verification_sha256", True)]:
+            assert all(_sha(ROOT / name, normalized) == digest for name, digest in report[category].items()), \
+                "Acceptance inputs/code/tests changed during the run"
+        report["artifacts_sha256"] = {p.name: _sha(p) for p in sorted(out.glob("*.png"))}
+        report["status"] = "pass"
+    except Exception as error:
+        report["status"] = "fail"
+        report["error"] = f"{type(error).__name__}: {error}"
+        raise
+    finally:
+        report["finished_at"] = datetime.now(timezone.utc).isoformat()
+        (out / "report.json").write_text(json.dumps(report, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+        print(f"Authenticated acceptance {report['status']}: {out / 'report.json'}", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
