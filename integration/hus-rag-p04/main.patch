+        mark_catalog_reviewed_for_test,
+    )
+    from tests.support.system_auth import SyntheticAccounts
+
+    root, profile_path = create_catalog_fixture(out / "synthetic_ui")
+    patch.setattr(catalogs, "DATA_ROOT", root)
+    patch.setattr(profiles_module, "PROFILES_PATH", profile_path)
+    get_settings.cache_clear()
+    auth_settings.cache_clear()
+    original_load, original_list = catalogs.load_catalog, catalogs.list_catalogs
+    patch.setattr(academic, "load_catalog", lambda pid: mark_catalog_reviewed_for_test(original_load(pid)))
+    patch.setattr(bindings, "list_catalogs", lambda: [mark_catalog_reviewed_for_test(c) for c in original_list()])
+    patch.setitem(academic.POLICIES, "synthetic-only-rag-e2e", AcademicPolicy(
+        "synthetic-only-rag-e2e", "synthetic-only:policy-spec",
+        tuple(pid for _, pid, _ in PROGRAMS.values()), {"D": (4, 4.9, 1)}))
+    saved = {}
+    patch.setattr(store, "profile", lambda owner: deepcopy(saved[owner]))
+    patch.setattr(semester_plan_service, "list_plans", lambda principal: [])
+    accounts = SyntheticAccounts(patch)
+    state = SyntheticWorkspace(base, accounts, saved)
+
+    def forbidden(*args, **kwargs):
+        raise AssertionError("Product DB/provider must not be used in this synthetic HUS acceptance")
+
+    patch.setattr(repository, "engine", forbidden)
+    patch.setattr(academic, "chat_advisor", forbidden)
+    patch.setattr(academic, "configured_adapters", forbidden)
+    original_http = httpx.HTTPTransport.handle_request
+
+    def loopback_only(transport, request):
+        if str(request.url).startswith(base + "/"):
+            return original_http(transport, request)
+        return forbidden()
+
+    patch.setattr(httpx.HTTPTransport, "handle_request", loopback_only)
+    patch.setattr(httpx.AsyncHTTPTransport, "handle_async_request", forbidden)
+    runtime.sessions.clear()
+    server = uvicorn.Server(uvicorn.Config(app, log_level="error"))
+    worker = threading.Thread(target=server.run, kwargs={"sockets": [sock]}, daemon=True)
+    worker.start()
+    try:
+        deadline = time.monotonic() + 20
+        while not server.started:
+            if not worker.is_alive() or time.monotonic() > deadline:
+                raise AssertionError("Isolated authenticated server failed to start")
+            threading.Event().wait(0.05)
+        yield state
+    finally:
+        server.should_exit = True
+        worker.join(timeout=10)
+        sock.close()
+        state.close()
+        runtime.sessions.clear()
+        patch.undo()
+        get_settings.cache_clear()
+        auth_settings.cache_clear()
