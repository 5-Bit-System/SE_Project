+/* Account-owned advisor chat for the active VNU workspace. No persisted history. */
+(() => {
+  'use strict';
+
+  function citationCard(document, citation, baseURI) {
+    const ai = citation.content_origin === 'generated' || citation.evidence_kind === 'ai';
+    const pages = Array.isArray(citation.pdf_pages) ? citation.pdf_pages : [];
+    const code = typeof citation.metadata?.course_code === 'string' ? citation.metadata.course_code : '';
+    const label = ai ? `kiến thức AI${code ? ' — ' + code : ''}`
+      : `${citation.evidence_kind === 'file' ? 'Tệp DOCX — ' : ''}${citation.display_label || citation.label || 'Nguồn'}${citation.evidence_kind === 'pdf' && pages.length ? '; trang PDF ' + pages.join(', ') : ''}`;
+    let url = null;
+    if (!ai && typeof citation.open_url === 'string') {
+      try {
+        const candidate = new URL(citation.open_url, baseURI);
+        const safe = ['http:', 'https:'].includes(candidate.protocol) && !candidate.username && !candidate.password;
+        if (safe && ['pdf', 'file'].includes(citation.evidence_kind)) {
+          const sha = citation.document_sha256;
+          const page = citation.pdf_page;
+          const validPage = page == null || (Number.isInteger(page) && page > 0);
+          const validSpan = pages.every(p => Number.isInteger(p) && p > 0)
+            && (!pages.length || pages[0] === page);
+          const expected = `/hus/sources/${sha}${page == null ? '' : `?page=${page}#page=${page}`}`;
+          if (/^[a-f0-9]{64}$/.test(sha || '') && validPage && validSpan
+              && (citation.evidence_kind === 'pdf' || (page == null && !pages.length))
+              && candidate.origin === new URL(baseURI).origin && citation.availability === 'available'
+              && candidate.pathname + candidate.search + candidate.hash === expected) url = candidate;
+        } else if (safe && citation.evidence_kind === 'web' && citation.open_url === citation.source_url
+                   && !/\s/.test(citation.open_url)) url = candidate;
+      } catch { /* Invalid evidence remains visible as plain text. */ }
+    }
+    const item = document.createElement('li');
+    const content = document.createElement(url ? 'a' : 'span');
+    if (url) {
+      content.href = url.href; content.target = '_blank'; content.rel = 'noopener noreferrer';
+    }
+    const note = !ai && typeof citation.availability_note === 'string' ? '; ' + citation.availability_note : '';
+    const review = typeof citation.review_status === 'string' ? '; review: ' + citation.review_status : '';
+    content.textContent = `Nguồn [${citation.citation_id || '?'}]: ${label}${review}${note}`;
+    item.append(content);
+    return {item, key: JSON.stringify([ai ? 'ai' : citation.evidence_kind,
+      citation.source_id || '', url?.href || '', pages, label, citation.quote || '',
+      citation.metadata?.field || '', citation.availability || ''])};
+  }
+
+  function createChat(window, document) {
+    const auth = () => window.systemAuth;
+    const accountKey = () => {
+      const account = auth()?.account;
+      return account?.account_id && account.session_id && !account.must_change_password
+        ? `${account.account_id}:${account.session_id}` : null;
+    };
+    const text = (vi, en) => window.workspaceI18n?.language === 'en' ? en : vi;
+    const node = (tag, id, className) => {
+      const value = document.createElement(tag);
+      if (id) value.id = id;
+      if (className) value.className = className;
+      return value;
+    };
+    let identity = accountKey(), sourceKey = '', selections = {selected_track_id: null, selected_graduation_path_id: null};
+    let generation = 0, refreshSequence = 0, sendSequence = 0;
+    let context = null, fingerprint = '', busy = false, open = false, history = [];
+    let notice = '';
+    const root = node('aside', 'hus-chat', 'hus-chat');
+    const launcher = node('button', 'hus-chat-launcher', 'hus-chat-launcher');
+    launcher.type = 'button'; launcher.setAttribute('aria-controls', 'hus-chat-panel');
+    const panel = node('section', 'hus-chat-panel', 'hus-chat-panel');
+    panel.hidden = true; panel.setAttribute('role', 'dialog'); panel.setAttribute('aria-labelledby', 'hus-chat-title');
+    const header = node('header', null, 'hus-chat-header');
+    const title = node('h2', 'hus-chat-title');
+    const close = node('button', 'hus-chat-close', 'hus-chat-close'); close.type = 'button'; close.textContent = '×';
+    header.append(title, close);
+    const status = node('p', 'hus-chat-status', 'hus-chat-status'); status.setAttribute('role', 'status');
+    const refresh = node('button', 'hus-chat-refresh', 'hus-chat-refresh'); refresh.type = 'button';
+    const messages = node('div', 'hus-chat-messages', 'hus-chat-messages');
+    messages.setAttribute('role', 'log'); messages.setAttribute('aria-live', 'polite');
+    const form = node('form', 'hus-chat-form', 'hus-chat-form');
+    const label = node('label', null, 'hus-chat-input-label'); label.htmlFor = 'hus-chat-input';
+    const input = node('textarea', 'hus-chat-input'); input.maxLength = 1000; input.rows = 2; input.required = true;
+    const consent = node('label', null, 'hus-chat-consent');
+    const optin = node('input', 'hus-chat-generated-opt-in'); optin.type = 'checkbox';
+    const consentText = node('span'); consent.append(optin, consentText);
+    const send = node('button', 'hus-chat-send', 'hus-chat-send'); send.type = 'submit';
+    form.append(label, input, consent, send);
+    panel.append(header, status, refresh, messages, form); root.append(launcher, panel); document.body.append(root);
+
+    const gateMessage = () => text('Cần hồ sơ và chương trình đã xác nhận, cùng ngữ cảnh học tập sẵn sàng để hỏi.',
+      'A confirmed curriculum and ready academic context are required to chat.');
+    function render() {
+      const signedIn = Boolean(identity && identity === accountKey());
+      launcher.hidden = !signedIn; panel.hidden = !open || !signedIn;
+      launcher.textContent = text('Hỏi đáp học tập', 'Study advisor');
+      launcher.setAttribute('aria-expanded', String(open && signedIn));
+      title.textContent = text('Hỏi đáp học tập', 'Study advisor');
+      close.setAttribute('aria-label', text('Đóng hỏi đáp', 'Close chat'));
+      label.textContent = text('Câu hỏi của bạn', 'Your question');
+      input.placeholder = text('Ví dụ: MAT3533 có bao nhiêu tín chỉ?', 'Example: How many credits is MAT3533?');
+      consentText.textContent = text('Cho phép kiến thức AI tham khảo', 'Allow AI reference knowledge');
+      send.textContent = busy ? text('Đang trả lời…', 'Answering…') : text('Gửi', 'Send');
+      refresh.textContent = text('Cập nhật ngữ cảnh', 'Refresh context');
+      send.disabled = busy || !context || !signedIn; input.disabled = busy || !context || !signedIn;
+      refresh.disabled = busy || !signedIn;
+      status.textContent = notice || (context ? text('Đang dùng chương trình đã xác nhận của tài khoản.',
+        'Using your account’s confirmed curriculum.') : gateMessage());
+      panel.setAttribute('aria-busy', String(busy));
+    }
+    function clear(message = '') {
+      generation++; refreshSequence++; sendSequence++;
+      context = null; fingerprint = ''; busy = false; history = []; notice = message;
+      input.value = ''; optin.checked = false; messages.replaceChildren(); render();
+    }
+    function current(epoch, owner) { return generation === epoch && owner === identity && owner === accountKey(); }
+    function append(role, content, citations = []) {
+      const message = node('article', null, `hus-chat-message hus-chat-${role}`);
+      const body = node('p', null, 'hus-chat-body'); body.textContent = content; message.append(body);
+      if (Array.isArray(citations)) {
+        const list = node('ul', null, 'hus-chat-sources'), seen = new Set();
+        citations.forEach(citation => {
+          if (!citation || typeof citation !== 'object') return;
+          const card = citationCard(document, citation, document.baseURI);
+          if (!seen.has(card.key)) { seen.add(card.key); list.append(card.item); }
+        });
+        if (list.childElementCount) message.append(list);
+      }
+      messages.append(message); messages.scrollTop = messages.scrollHeight;
+    }
+    async function refreshContext(mode = 'open') {
+      let epoch = generation;
+      const owner = identity, ticket = ++refreshSequence;
+      if (!owner) return null;
+      await auth().ready;
+      if (!current(epoch, owner) || ticket !== refreshSequence) return null;
+      await auth().refresh();
+      if (!current(epoch, owner) || ticket !== refreshSequence) return null;
+      const options = await auth().request('/me/academic-program');
+      if (!current(epoch, owner) || ticket !== refreshSequence) return null;
+      const binding = options.binding;
+      if (!binding || binding.verified !== true || !binding.evidence_ref || typeof binding.program_id !== 'string') {
+        clear(gateMessage()); return null;
+      }
+      const params = new URLSearchParams({program_id: binding.program_id});
+      Object.entries(selections).forEach(([key, value]) => { if (value) params.set(key, value); });
+      const result = await auth().request(`/me/academic-context?${params}`);
+      if (!current(epoch, owner) || ticket !== refreshSequence) return null;
+      if (result.status !== 'ready' || result.program_id !== binding.program_id || !/^[a-f0-9]{64}$/.test(result.revision || '')) {
+        clear(gateMessage()); return null;
+      }
+      const key = JSON.stringify([binding.program_id, result.revision]);
+      const changed = Boolean(fingerprint && fingerprint !== key);
+      if (changed) {
+        clear(text('Ngữ cảnh đã đổi. Hãy nhập lại câu hỏi cho chương trình hiện tại.',
+          'The context changed. Enter your question again for the current curriculum.'));
+        epoch = generation;
+      }
+      context = {program_id: binding.program_id, revision: result.revision, ...selections};
+      fingerprint = key;
+      if (!changed || mode !== 'send') notice = '';
+      render();
+      return {context: {...context}, epoch, owner, changed};
+    }
+    async function sync(mode) {
+      const epoch = generation, owner = identity;
+      const ticket = refreshSequence + 1;
+      notice = text('Đang kiểm tra ngữ cảnh tài khoản…', 'Checking your account context…'); render();
+      try { return await refreshContext(mode); }
+      catch {
+        if (current(epoch, owner) && ticket === refreshSequence) clear(gateMessage());
+        return null;
+      }
+    }
+    async function submit(event) {
+      event.preventDefault();
+      const question = input.value.trim();
+      if (busy || !question || !context || !identity) return;
+      busy = true; notice = ''; render();
+      const ticket = ++sendSequence;
+      const fresh = await sync('send');
+      if (!fresh || fresh.changed || ticket !== sendSequence || !current(fresh.epoch, fresh.owner)) {
+        if (ticket === sendSequence) { busy = false; render(); }
+        return;
+      }
+      const payload = {program_id: fresh.context.program_id, expected_revision: fresh.context.revision,
+        selected_track_id: fresh.context.selected_track_id, selected_graduation_path_id: fresh.context.selected_graduation_path_id,
+        message: question, history: history.slice(-6), allow_generated_reference: optin.checked === true};
+      append('user', question); input.value = '';
+      try {
+        const result = await auth().request('/me/advisor/chat', 'POST', payload);
+        if (!current(fresh.epoch, fresh.owner) || ticket !== sendSequence) return;
+        if (result.context_revision !== fresh.context.revision || typeof result.reply !== 'string') {
+          clear(text('Ngữ cảnh đã đổi. Cập nhật ngữ cảnh trước khi hỏi tiếp.', 'The context changed. Refresh before asking again.'));
+          return;
+        }
+        append('assistant', result.reply, result.mode === 'hus_rag' ? result.hus_answer?.citations : []);
+        history = [...history, {role: 'user', content: question.slice(0, 300)},
+          {role: 'assistant', content: result.reply.slice(0, 300)}].slice(-6);
+        notice = '';
+      } catch {
+        if (current(fresh.epoch, fresh.owner) && ticket === sendSequence) clear(gateMessage());
+      } finally {
+        if (current(fresh.epoch, fresh.owner) && ticket === sendSequence) { busy = false; render(); input.focus(); }
+      }
+    }
+    function toggle(value) {
+      open = value; render();
+      if (open) sync('open').then(() => { if (open && context) input.focus(); });
+      else launcher.focus();
+    }
+    launcher.addEventListener('click', () => toggle(!open)); close.addEventListener('click', () => toggle(false));
+    panel.addEventListener('keydown', event => { if (event.key === 'Escape') { event.preventDefault(); toggle(false); } });
+    form.addEventListener('submit', submit);
+    refresh.addEventListener('click', () => sync('open'));
+    document.addEventListener('workspace:account-change', () => {
+      const next = accountKey();
+      if (next === identity) { render(); return; }
+      identity = next; sourceKey = ''; selections = {selected_track_id: null, selected_graduation_path_id: null};
+      clear(); if (!next) open = false; render(); if (next && open) sync('open');
+    });
+    document.addEventListener('workspace:session-expired', () => {
+      if (auth()?.account) auth().expire?.('session_expired');
+      identity = null; sourceKey = ''; open = false; clear();
+    });
+    document.addEventListener('workspace:portal-data', event => {
+      const source = event.detail;
+      const next = source ? JSON.stringify([source.snapshot, source.profile]) : '';
+      if (next === sourceKey) return;
+      sourceKey = next; clear(); if (open && identity) sync('open');
+    });
+    document.addEventListener('workspace:academic-context-change', event => {
+      const detail = event.detail || {};
+      const next = {selected_track_id: detail.selected_track_id || null,
+        selected_graduation_path_id: detail.selected_graduation_path_id || null};
+      if (JSON.stringify(next) === JSON.stringify(selections) && detail.reason !== 'program-binding') return;
+      selections = next; clear(); if (open && identity) sync('open');
+    });
+    document.addEventListener('workspace:language-change', render);
+    document.addEventListener('visibilitychange', () => { if (!document.hidden && open && identity) sync('open'); });
+    render();
+    document.dispatchEvent(new Event('workspace:academic-context-request'));
+    return {refresh: () => sync('open'), submit, toggle, append,
+      elements: {root, launcher, panel, messages, input, optin, send, status},
+      get state() { return {identity, generation, context, history: history.map(value => ({...value})), busy}; }};
+  }
+
+  if (typeof module !== 'undefined' && module.exports) module.exports = {createChat, citationCard};
+  else createChat(window, document);
+})();
