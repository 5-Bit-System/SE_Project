@@ -0,0 +1,32 @@
+"""RAG adapter invoked only after the source-owned academic context gate."""
+
+from fastapi import HTTPException
+
+from app.hus.answering import is_hus_question, question_intent
+from app.hus.rag_loader import RAGDataError
+from app.schemas.advisor import AdvisorRequest, AdvisorResponse
+from app.schemas.hus import HUSQuestion
+from app.services.advisor_service import check_scope_guardrails
+from app.services.hus_service import get_hus_answerer
+
+
+def is_hus_information(message: str) -> bool:
+    triggered, _, _ = check_scope_guardrails(message)
+    return not triggered and is_hus_question(message)
+
+
+def answer_hus(catalog, request: AdvisorRequest) -> AdvisorResponse:
+    """Use the catalog identity resolved from the verified owner binding, never a major payload."""
+    try:
+        answerer = get_hus_answerer()
+        scope = answerer.programs.get(catalog.program.program_id)
+        if scope is None:
+            raise HTTPException(409, "hus_program_unavailable")
+        major, version = scope
+        dataset, _ = question_intent(request.message)
+        answer = answerer.answer(HUSQuestion(question=request.message, major=major,
+            version=None if dataset == "f1" else version,
+            allow_generated_reference=request.allow_generated_reference))
+        return AdvisorResponse(reply=answer.reply, mode="hus_rag", hus_answer=answer)
+    except RAGDataError:
+        raise HTTPException(503, "hus_data_unavailable") from None
