--- /dev/null
+++ b/tests/frontend/hus-chat.test.cjs
@@ -0,0 +1,205 @@
+const assert = require('node:assert/strict');
+const test = require('node:test');
+const {createChat, citationCard} = require('../../app/static/hus-chat.js');
+
+function element(tag) {
+  const listeners = {};
+  return {tag, children: [], textContent: '', hidden: false, disabled: false, checked: false, value: '',
+    append(...values) { this.children.push(...values); },
+    replaceChildren(...values) { this.children = [...values]; },
+    setAttribute(name, value) { this[name] = value; },
+    addEventListener(name, callback) { (listeners[name] ||= []).push(callback); },
+    focus() { this.focused = true; },
+    get childElementCount() { return this.children.length; },
+  };
+}
+function setup(initialSelections = null) {
+  const listeners = {}, calls = [], pending = [], heldContexts = [];
+  const state = {account: {account_id: 'owner-a', session_id: 'session-a'},
+    program: 'bound-program-a', revision: 'a'.repeat(64), status: 'ready', binding: true};
+  const document = {body: element('body'), baseURI: 'http://localhost:8000/', hidden: false,
+    createElement: element, addEventListener(name, callback) { (listeners[name] ||= []).push(callback); },
+    dispatchEvent(event) { (listeners[event.type] || []).forEach(callback => callback(event)); }};
+  const emit = (type, detail) => (listeners[type] || []).forEach(callback => callback({type, detail}));
+  if (initialSelections) document.addEventListener('workspace:academic-context-request', () => {
+    emit('workspace:academic-context-change', {...initialSelections, reason: 'current-selections'});
+  });
+  const auth = {get account() { return state.account; }, ready: Promise.resolve(),
+    async refresh() { emit('workspace:account-change', state.account); },
+    expire() { state.account = null; emit('workspace:account-change', null); },
+    async request(path, method = 'GET', body) {
+      calls.push({path, method, body});
+      if (path === '/me/academic-program') return {binding: state.binding
+        ? {verified: true, program_id: state.program, evidence_ref: 'synthetic-confirmation'} : null};
+      if (path.startsWith('/me/academic-context?')) {
+        if (state.holdNextContext) {
+          state.holdNextContext = false;
+          return new Promise((resolve, reject) => heldContexts.push({resolve, reject}));
+        }
+        return {program_id: state.program, revision: state.revision, status: state.status};
+      }
+      if (path === '/me/advisor/chat' && method === 'POST') return new Promise(resolve => pending.push({body, resolve}));
+      throw Error('Unexpected request ' + path);
+    }};
+  const window = {systemAuth: auth, workspaceI18n: {language: 'vi'}};
+  const chat = createChat(window, document);
+  return {chat, state, calls, pending, heldContexts, document, emit};
+}
+const tick = () => new Promise(resolve => setImmediate(resolve));
+async function start(chat, question = 'Số tín chỉ MAT3533?') {
+  chat.elements.input.value = question;
+  const result = chat.submit({preventDefault() {}});
+  await tick();
+  return {result};
+}
+function complete(pending, reply = 'Answer', extra = {}) {
+  pending.resolve({reply, mode: 'hus_rag', context_revision: pending.body.expected_revision,
+    hus_answer: {citations: []}, ...extra});
+}
+
+test('uses authoritative binding and current revision, with opt-in off and bounded history', async () => {
+  const {chat, calls, pending} = setup();
+  await chat.refresh();
+  const {result} = await start(chat);
+  assert.equal(pending.length, 1);
+  assert.equal(pending[0].body.program_id, 'bound-program-a');
+  assert.equal(pending[0].body.expected_revision, 'a'.repeat(64));
+  assert.equal(pending[0].body.allow_generated_reference, false);
+  assert.deepEqual(pending[0].body.history, []);
+  assert.ok(calls.some(call => call.path.startsWith('/me/academic-context?program_id=bound-program-a')));
+  complete(pending[0]); await result;
+  assert.equal(chat.state.history.length, 2);
+  assert.equal(chat.elements.messages.children.length, 2);
+});
+
+test('changing account drops a late answer and cannot unlock a newer pending request', async () => {
+  const {chat, state, emit, pending} = setup();
+  await chat.refresh();
+  const first = await start(chat);
+  state.account = {account_id: 'owner-b', session_id: 'session-b'};
+  state.program = 'bound-program-b'; state.revision = 'b'.repeat(64);
+  emit('workspace:account-change', state.account);
+  assert.equal(chat.elements.messages.children.length, 0);
+  await chat.refresh();
+  const second = await start(chat, 'Nội dung môn khác');
+  assert.equal(pending[1].body.program_id, 'bound-program-b');
+  complete(pending[0], 'OLD OWNER'); await first.result;
+  assert.equal(chat.state.busy, true);
+  assert.equal(chat.elements.send.disabled, true);
+  assert.ok(!chat.state.history.some(row => row.content === 'OLD OWNER'));
+  complete(pending[1], 'NEW OWNER'); await second.result;
+  assert.equal(chat.state.busy, false);
+  assert.equal(chat.state.history[1].content, 'NEW OWNER');
+});
+
+test('unchanged account/source refreshes preserve chat; source changes clear it and AI consent', async () => {
+  const {chat, state, emit, pending} = setup();
+  const source = {snapshot: {digest: 'source-a'}, profile: {program: 'Display only'}};
+  emit('workspace:portal-data', source); await chat.refresh();
+  chat.elements.optin.checked = true;
+  const first = await start(chat);
+  complete(pending[0]); await first.result;
+  emit('workspace:account-change', state.account);
+  emit('workspace:portal-data', {...source, fetched_at: 'later', latest_collection: {save_status: 'retained'}});
+  await chat.refresh();
+  assert.equal(chat.state.history.length, 2);
+  assert.equal(chat.elements.optin.checked, true);
+  emit('workspace:portal-data', {...source, snapshot: {digest: 'source-b'}});
+  assert.equal(chat.state.history.length, 0);
+  assert.equal(chat.elements.messages.children.length, 0);
+  assert.equal(chat.elements.optin.checked, false);
+});
+
+test('an authoritative revision change clears the old question instead of sending it to a new context', async () => {
+  const {chat, state, pending} = setup();
+  await chat.refresh();
+  const first = await start(chat); complete(pending[0]); await first.result;
+  chat.elements.optin.checked = true;
+  state.revision = 'b'.repeat(64);
+  const changed = await start(chat, 'OLD CONTEXT QUESTION'); await changed.result;
+  assert.equal(pending.length, 1);
+  assert.equal(chat.state.history.length, 0);
+  assert.equal(chat.elements.input.value, '');
+  assert.equal(chat.elements.optin.checked, false);
+  assert.equal(chat.state.context.revision, state.revision);
+});
+
+test('an older failed context refresh cannot clear a newer successful refresh', async () => {
+  const {chat, state, heldContexts} = setup();
+  await chat.refresh();
+  state.holdNextContext = true;
+  const older = chat.refresh(); await tick();
+  assert.equal(heldContexts.length, 1);
+  await chat.refresh();
+  const generation = chat.state.generation;
+  heldContexts[0].reject(new Error('Superseded context request failed'));
+  await older;
+  assert.equal(chat.state.generation, generation);
+  assert.equal(chat.state.context.revision, state.revision);
+  assert.equal(chat.elements.send.disabled, false);
+});
+
+test('track/path and binding notifications invalidate history and preserve selections in context requests', async () => {
+  const {chat, calls, emit, pending} = setup();
