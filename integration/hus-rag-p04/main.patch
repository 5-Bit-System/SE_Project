+              "AUTH_TOKEN_PEPPER": "synthetic-hus-acceptance-secret-at-least-32-characters",
+              "PUBLIC_BASE_URL": base, "AUTH_ALLOWED_ORIGINS": base, "EMAIL_BACKEND": "fake"}
+    for key, value in values.items():
+        patch.setenv(key, value)
+
+    import app.catalog as catalogs
+    import app.profiles as profiles_module
+    import app.program_bindings as bindings
+    from app.academic_context import AcademicPolicy
+    from app.api import academic
