+  const second = await start(chat); complete(pending[1]); await second.result;
+  emit('workspace:academic-context-change', {selected_track_id: 'track-a', selected_graduation_path_id: 'thesis'});
+  assert.equal(chat.state.history.length, 2);
+  emit('workspace:academic-context-change', {selected_track_id: 'track-a', selected_graduation_path_id: 'thesis', reason: 'program-binding'});
+  assert.equal(chat.state.history.length, 0);
+});
