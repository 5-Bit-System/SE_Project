+    def __init__(self, base, accounts, profiles):
+        self.base, self.accounts, self.profiles = base, accounts, profiles
+        self.clients = []
+
+    def issue(self, owner, program_id):
+        import httpx
+
+        client = httpx.Client(base_url=self.base, headers={"Origin": self.base},
+                              trust_env=False, timeout=30)
+        self.accounts.issue(client, owner, "synthetic-hus-" + owner, linked=True)
+        account = self.accounts.resolve(client.cookies.get("study_app_session"))
+        account.update(vnu_subject="synthetic-hus-" + owner, auth_method="vnu", email=None,
+                       display_name="Synthetic HUS acceptance")
+        self.profiles[owner] = self.profile(owner, program_id)
+        self.clients.append(client)
+        return client
+
+    @staticmethod
+    def profile(owner, program_id):
+        from app.api.academic import _catalog_context
+
+        _, revision = _catalog_context(program_id)
+        return {"subject": "synthetic-hus-" + owner,
+                "profile": {"name": "Synthetic HUS acceptance", "program": program_id, "cohort": "K67",
+                            "academic_binding": {"program_id": program_id, "catalog_revision": revision,
+                                "verified": True, "evidence_ref": "synthetic-only:review",
+                                "policy_version": "synthetic-only-rag-e2e", "cohort": 67}},
+                "snapshot": {"schema_version": 1, "completeness": "complete", "digest": "synthetic:" + owner,
+                             "attempts": [{"row_key": "synthetic-1", "code": "PHI1006", "name": "Synthetic PHI1006",
+                                "credits": "3", "grade10": "4.2", "letter": "D", "grade4": "1",
+                                "term": "HỌC KỲ 1 2022–2023"}], "unknown_rows": []},
+                "fetched_at": "2026-11-02T00:00:00Z", "last_synced_at": "2026-11-02T00:00:00Z"}
+
+    def context(self, client, program_id):
+        result = client.get("/me/academic-context", params={"program_id": program_id})
+        assert result.status_code == 200 and result.json()["status"] == "ready", result.text
