+/* Floating advisor shares the active workspace palette without changing its layout. */
+.hus-chat { font-family: inherit; color: var(--text-main); }
+.hus-chat [hidden] { display: none !important; }
+.hus-chat-launcher { position: fixed; right: 24px; bottom: 24px; z-index: 100;
+  min-height: 48px; padding: 12px 20px; border: 0; border-radius: 24px;
+  background: var(--accent-primary); color: #fff; font: inherit; font-weight: 600;
+  box-shadow: var(--shadow-overlay); cursor: pointer; }
+.hus-chat-panel { position: fixed; right: 24px; bottom: 84px; z-index: 101;
+  width: min(430px, calc(100vw - 32px)); max-height: min(690px, calc(100dvh - 116px));
+  display: flex; flex-direction: column; overflow: hidden; background: var(--bg-surface);
+  border: 1px solid var(--border-subtle); border-radius: var(--radius-surface); box-shadow: var(--shadow-overlay); }
+.hus-chat-header { display: flex; align-items: center; justify-content: space-between;
+  gap: 16px; padding: 14px 18px; border-bottom: 1px solid var(--border-subtle); }
+.hus-chat-header h2 { margin: 0; font-size: 17px; }
+.hus-chat-close { width: 36px; height: 36px; border: 0; border-radius: var(--radius-control);
+  color: var(--text-main); background: var(--soft-surface); font-size: 26px; cursor: pointer; }
+.hus-chat-status { margin: 12px 18px 6px; color: var(--text-muted); font-size: 12px; line-height: 1.65; }
+.hus-chat-refresh { align-self: flex-start; margin: 0 18px 8px; padding: 4px 0;
+  border: 0; color: var(--accent-primary); background: transparent; font: inherit; font-size: 12px; cursor: pointer; }
+.hus-chat-messages { overflow-y: auto; overscroll-behavior: contain; min-height: 60px;
+  padding: 0 18px; display: flex; flex-direction: column; gap: 12px; }
+.hus-chat-message { max-width: 100%; min-width: 0; border-radius: 10px; padding: 10px 12px;
+  background: var(--soft-surface); font-size: 13px; line-height: 1.8; }
+.hus-chat-user { align-self: flex-end; background: var(--selected-surface); }
+.hus-chat-body { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; }
+.hus-chat-sources { margin: 10px 0 0; padding-left: 18px; font-size: 12px; overflow-wrap: anywhere; }
+.hus-chat-sources li + li { margin-top: 7px; }
+.hus-chat-sources a { color: var(--accent-primary); text-decoration: underline; text-underline-offset: 2px; }
+.hus-chat-form { padding: 12px 18px 16px; border-top: 1px solid var(--border-subtle);
+  margin-top: 12px; display: grid; grid-template-columns: 1fr auto; gap: 8px 12px; }
+.hus-chat-input-label { grid-column: 1 / -1; font-size: 12px; font-weight: 600; }
+.hus-chat-form textarea { grid-column: 1 / -1; resize: vertical; min-height: 58px; max-height: 120px;
+  width: 100%; box-sizing: border-box; padding: 10px; font: inherit; font-size: 13px;
+  color: var(--text-main); background: var(--bg-input); border: 1px solid var(--border-medium); border-radius: 8px; }
+.hus-chat-consent { display: flex; align-items: flex-start; gap: 7px; font-size: 11px; line-height: 1.65; }
