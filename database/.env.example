# Copy to database/.env.docker and replace both password placeholders.
# This configuration is independent of the application's root .env.
HUS_POSTGRES_USER=ai07
HUS_POSTGRES_PASSWORD=replace_with_a_random_password
HUS_POSTGRES_PORT=5433
HUS_DATABASE_URL=postgresql://ai07:replace_with_a_random_password@127.0.0.1:5433/ai07?sslmode=disable
