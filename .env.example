# =====================================================================
# MẪU BIẾN MÔI TRƯỜNG (ENV TEMPLATE) — AI-07
# Copy file này thành .env và điền API key của bạn:
# =====================================================================

# 1. API Key (Nhập key từ Beeknoee hoặc Google AI Studio của bạn vào đây):
GEMINI_API_KEY=your_api_key_here

# 2. Base URL khi dùng cổng Beeknoee (để trống nếu dùng Google AI Studio trực tiếp):
GEMINI_BASE_URL=https://platform.beeknoee.com/api/v1

# 3. Model LLM sử dụng:
GEMINI_MODEL=gemini-3.8-flash

# 4. Môi trường thực thi (dev | prod | test):
APP_ENV=dev

# 5. Cấu hình Cơ sở dữ liệu (PostgreSQL qua Docker):
# Hướng dẫn chọn HOST:
# - Chạy backend tại máy local (ngoài Docker): DB_HOST=localhost (hoặc POSTGRES_HOST=localhost)
# - Chạy backend trong Docker network (cùng docker-compose): DB_HOST=db (tên service)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=course_recommender

# Hỗ trợ song song các biến chuẩn của image PostgreSQL Docker:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=course_recommender

# Chuỗi kết nối tổng hợp (tùy chọn, nếu có sẽ được ưu tiên cao nhất):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/course_recommender
