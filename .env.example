# =====================================================================
# MẪU BIẾN MÔI TRƯỜNG (ENV TEMPLATE) — AI-07
# Xem docs/LOCAL_SETUP.md; chỉ tạo .env nếu chưa có. LLM là tùy chọn:
# =====================================================================

# 1. API Key (Nhập key từ Beeknoee hoặc Google AI Studio của bạn vào đây):
GEMINI_API_KEY=your_api_key_here

# 2. Base URL khi dùng cổng Beeknoee (để trống nếu dùng Google AI Studio trực tiếp):
GEMINI_BASE_URL=https://platform.beeknoee.com/api/v1

# 3. Model LLM sử dụng:
GEMINI_MODEL=gemini-3.8-flash

# 4. Database runtime (json chỉ dùng kiểm thử/offline khi chọn rõ ràng):
STORAGE_BACKEND=postgres
# HUS is the default runtime model. Set legacy to read the old project database.
DATABASE_MODEL=hus
# Runtime always reads DATABASE_URL. Point it to the HUS ai07 database.
DATABASE_URL=postgresql+psycopg2://postgres:replace_with_a_local_password@127.0.0.1:5433/ai07?sslmode=disable
# Set HUS_DATABASE_URL to the same target; migration CLI loads root .env.
# Other DB tools need shell variables, database/.env.docker or an explicit dotenv wrapper.
HUS_DATABASE_URL=postgresql+psycopg2://postgres:replace_with_a_local_password@127.0.0.1:5433/ai07?sslmode=disable
# For rollback, set DATABASE_MODEL=legacy and DATABASE_URL to the old database.

# 5. Tắt LLM để chạy hoàn toàn offline:
RECOMMENDATION_LLM_ENABLED=false

# 6. System authentication has separate settings in ignored .env.auth.
# Copy .env.auth.example and generate AUTH_TOKEN_PEPPER; keep existing settings.
# See docs/VNU_SIGNIN_2026_10_25.md for VNU student/admin login. Never commit .env.auth.

# Standalone HUS Q&A; independent of the course recommendation chatbot.
# Lexical = BM25 retrieval; retrieved evidence can also be passed to Gemini.
# It works without optional ML dependencies/model/index/network.
# V4/V5: vector and hybrid are explicit; both fall back to scoped BM25 on vector errors.
# Hybrid policy: BM25 top20/vector top20 passages -> parent dedup -> RRF60 -> final5.
HUS_RETRIEVAL_MODE=lexical
# Leave these blank for lexical. Set all three for vector OR hybrid.
# The expected index ID must be pinned outside the DB.
HUS_VECTOR_INDEX_PATH=
HUS_VECTOR_MODEL_CACHE=
HUS_VECTOR_EXPECTED_INDEX_ID=

# Optional HUS Q&A rewrite client (direct Google Gemini, OpenAI-compatible HTTP).
# Separate from the recommendation LLM. L3 is registered behind the L2 consent/source gates.
# L4 adds UI opt-in/one active rewrite per process; keep off until L5 content acceptance.
# Read explicitly via HUSLLMSettings.from_env(); no provider call at startup.
HUS_LLM_ENABLED=false
HUS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
HUS_LLM_MODEL=gemini-3.5-flash-lite
# Google AI Studio API key for HUS Q&A only; leave blank in this template.
HUS_LLM_API_KEY=AIzaSyBKx0fKWj-zWHCmymawpVSieZ09afANkYU
